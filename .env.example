# NextAuth base URL must match the frontend dev server port.
NEXTAUTH_URL=http://localhost:3000

# Set APP_ENV=production or NEXT_PUBLIC_APP_ENV=production in deployed environments.
# Production boot fails if required auth/backend secrets are missing or unsafe.
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Public canonical URL used by metadata, robots, and sitemap routes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public support contact shown on /support.
NEXT_PUBLIC_SUPPORT_EMAIL=support@creatorjobs.in

# Generate a random secret for JWT/session signing. Do not use this placeholder in production.
NEXTAUTH_SECRET=change-me-please

# Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Server-only YouTube Data API key for resolving channel names/logos in profile experience.
YOUTUBE_DATA_API_KEY=

# Server-only Google Places API key for profile location autocomplete.
GOOGLE_PLACES_API_KEY=

# Local Prisma SQLite database.
DATABASE_URL="file:./dev.db"

# External backend API (FastAPI) used by frontend data layer.
# Production requires this to be a non-localhost URL.
# Use 127.0.0.1 locally (not localhost) so Node does not try IPv6 ::1 first.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000/api/v1

# Optional server-side backend URL for production/private networking.
# If omitted, the frontend uses NEXT_PUBLIC_BACKEND_URL for server-side calls.
BACKEND_URL=http://127.0.0.1:8000/api/v1

# true = use deterministic local mock/SQLite data directly.
# false = use backend first. In `next dev` with a localhost backend URL,
# the Talent browser can still fall back to mocks if the local backend is down.
# Production boot fails if this is true, and production never silently uses mocks.
NEXT_PUBLIC_USE_LOCAL_MOCKS=false

# Local dev defaults: keep email/password auth visible and allow the dev data switch only
# when you explicitly need to test backend vs mock marketplace data.
NEXT_PUBLIC_ENABLE_EMAIL_AUTH=true
NEXT_PUBLIC_ENABLE_DEV_DATA_SWITCH=false

# Hosted investor staging example. Do not paste real secrets into this file.
# APP_ENV=staging
# NEXT_PUBLIC_APP_ENV=staging
# NEXTAUTH_URL=https://your-vercel-url
# NEXT_PUBLIC_SITE_URL=https://your-vercel-url
# NEXT_PUBLIC_BACKEND_URL=https://your-render-api/api/v1
# BACKEND_URL=https://your-render-api/api/v1
# NEXTAUTH_SECRET=replace-with-strong-random-value
# GOOGLE_CLIENT_ID=replace-me
# GOOGLE_CLIENT_SECRET=replace-me
# NEXT_PUBLIC_USE_LOCAL_MOCKS=false
# NEXT_PUBLIC_ENABLE_DEV_DATA_SWITCH=false
# NEXT_PUBLIC_ENABLE_EMAIL_AUTH=false
