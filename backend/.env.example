# Human-readable app name used in API docs and service metadata
APP_NAME=CreatorJobs Backend

# Runtime environment for local development
APP_ENV=development

# Email delivery strategy:
# - log: print verification URL to backend logs (local/dev)
# - smtp: real email provider. Required when APP_ENV=production.
EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Rate limiting strategy:
# - memory: process-local fallback for local/dev and single-instance demos
# - redis: shared limiter for multi-instance production. Requires REDIS_URL and redis>=5.
# Production boot fails with memory unless ALLOW_MEMORY_RATE_LIMIT_IN_PRODUCTION=true.
RATE_LIMIT_BACKEND=memory
REDIS_URL=
ALLOW_MEMORY_RATE_LIMIT_IN_PRODUCTION=false

# Frontend origin used for dev verification-link logging
FRONTEND_BASE_URL=http://localhost:3000

# Log verbosity level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Allowed frontend origins for browser requests.
# Must be valid JSON because this setting is parsed as a list.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# SQLAlchemy async database URL.
# Uses docker-compose service name "postgres" for container-to-container networking.
DATABASE_URL=postgresql+asyncpg://creatorjobs:creatorjobs@postgres:5432/creatorjobs

# JWT signing secret. Production boot fails if this is missing or left as a placeholder.
JWT_SECRET=change-me-please

# Access token TTL in minutes (generic naming used by many integrations)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Backend-specific token TTL variable currently read by FastAPI settings.
# Keep this aligned with ACCESS_TOKEN_EXPIRE_MINUTES.
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_MINUTES=43200

# Server-side YouTube Data API v3 key for portfolio metadata import.
# Do not expose this through NEXT_PUBLIC_* env vars.
YOUTUBE_API_KEY=

# Private, server-only OpenAI text extraction. Leave OPENAI_API_KEY blank unless
# the private job-import processing endpoint should make real provider calls.
# Never expose these values through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
JOB_IMPORT_PROMPT_VERSION=job-import-text-v1

# Local media storage. For hosted investor staging, the cheapest default is seeded
# external/demo image URLs. Uploaded avatars/banners may not survive redeploys unless
# you add optional persistent storage and point MEDIA_ROOT at that mounted path.
MEDIA_ROOT=.local-data/media
MEDIA_BASE_PATH=/media

# Hosted investor staging example. Do not paste real secrets into this file.
# APP_ENV=staging
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
# JWT_SECRET=replace-with-strong-random-value
# FRONTEND_BASE_URL=https://your-vercel-url
# CORS_ORIGINS=["https://your-vercel-url"]
# EMAIL_MODE=log
# EMAIL_DELIVERY_ENABLED=false
# RATE_LIMIT_BACKEND=memory
#
# Render Free hosted investor staging only. These commands run before FastAPI
# starts because Render Free does not provide an interactive Shell.
# RUN_DB_MIGRATIONS=true
# RUN_STAGING_SEED=true
#
# The staging seed is refused when APP_ENV=production. After the demo data has
# been created once, you can set RUN_STAGING_SEED=false in Render to skip the
# idempotent seed check on later deploys.
RUN_DB_MIGRATIONS=false
RUN_STAGING_SEED=false
#
# Optional only if using a Render persistent disk for avatar/banner uploads:
# MEDIA_ROOT=/var/data/media
# MEDIA_BASE_PATH=/media

# Controlled QA persona sessions. Leave disabled unless deliberately testing the
# isolated QA harness or a restricted investor-staging environment. The backend
# rejects this feature in production even if the flag is accidentally set.
ENABLE_QA_PERSONA_SWITCHER=false
# Comma-separated emails of normally authenticated controller accounts. Never add
# persona emails here and never place passwords or tokens in this variable.
QA_PERSONA_CONTROLLER_EMAILS=
# Short-lived persona access token lifetime. Persona sessions have no refresh token.
QA_PERSONA_ACCESS_TOKEN_MINUTES=30
